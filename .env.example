# AI provider configuration. DeepSeek is the default; switch by changing
# AI_PROVIDER to "openai" or "anthropic" and supplying the matching key.
# Leave AI_API_KEY empty to run the demo with hardcoded fallback content.

AI_PROVIDER=deepseek
AI_API_KEY=
# Optional overrides — sensible defaults per provider:
#   deepseek  → deepseek-chat,  baseURL https://api.deepseek.com
#   openai    → gpt-4o-mini,    baseURL (OpenAI default)
#   anthropic → claude-sonnet-4-6
# AI_MODEL=
# AI_BASE_URL=

# Legacy (still honored when AI_PROVIDER=anthropic and AI_API_KEY is empty):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
